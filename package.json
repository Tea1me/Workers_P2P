{
  "name": "workers-p2p",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test:browser": "vite build --config tests/browser/vite.config.ts && playwright test --config tests/browser/playwright.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@playwright/test": "1.64.1",
    "@roamhq/wrtc": "0.10.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261023.2-beta",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "4.155.0"
  }
}
